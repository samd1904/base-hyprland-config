{
  "layer": "top",
  "position": "top",
  "height": 25,
  "output": ["eDP-1", "HDMI-A-1"],
  "margin": "5 5 0 5",

  "group/left": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "mpris"]
  },

  "group/left-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["custom/arrow-right", "battery", "cpu", "load"]
  },

  "group/left-hidden-top": {
    "orientation": "horizontal",
    "modules": ["group/left-hidden"]
  },

  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "group/group-volume",
      "group/group-backlight",
      "network",
      "tray"
    ]
  },

  "group/center": {
    "orientation": "horizontal",
    "modules": ["battery", "clock", "cpu", "load"]
  },

  "group/right-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
      "click-to-reveal": true
    },
    "modules": ["custom/arrow-left", "memory", "temperature"]
  },

  "group/right-hidden-top": {
    "orientation": "horizontal",
    "modules": ["group/right-hidden", "custom/ctlcenter"]
  },

  "modules-left": ["group/left"],
  "modules-center": ["group/center"],
  "modules-right": ["group/right", "group/right-hidden-top"],

  "include": ["~/.config/waybar/modules.jsonc"]
}
